{
  "setup": "pnpm install --frozen-lockfile",
  "gates": [
    { "name": "format",    "run": "pnpm exec biome format --error-on-warnings .", "fix": "pnpm exec biome format --write ." },
    { "name": "lint",      "run": "pnpm exec biome check .",                      "fix": "pnpm exec biome check --fix ." },
    { "name": "typecheck", "run": "pnpm exec tsc --noEmit" },
    { "name": "test",      "run": "pnpm exec vitest run" }
  ]
}
