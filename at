#!/usr/bin/env bash
set -euo pipefail

# Thin front-door shim: `at` execs the Python engine at installer/at.py.
# The legacy manifest-based bash implementation is gone — issue #74 is a clean
# break with no migration path.

# Directory of this script, resolved even when invoked via a relative path.
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

if ! command -v uv >/dev/null 2>&1; then
	echo "error: 'uv' is required but was not found on PATH." >&2
	echo "Install it from https://docs.astral.sh/uv/ and try again." >&2
	exit 1
fi

exec uv run "$SCRIPT_DIR/installer/at.py" "$@"
