#!/usr/bin/env bash
set -euo pipefail

# =============================================================================
# at — Unified CLI for Claude Code Agent Templates
# =============================================================================
# Merges install.sh and validate.sh into a single script with subcommand
# dispatch. Bash 3.2 compatible (macOS default).
# =============================================================================

# --- Bash version check ------------------------------------------------------
if [[ "${BASH_VERSINFO[0]}" -lt 3 ]]; then
  echo "Error: bash 3.2+ required (found ${BASH_VERSION})"
  exit 1
fi

# --- Resolve script directory ------------------------------------------------
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"

# --- Version -----------------------------------------------------------------
AT_VERSION="0.1.0"

# --- Color helpers (degrade gracefully) --------------------------------------
if [ -t 1 ] && [ "${TERM:-dumb}" != "dumb" ]; then
  GREEN='\033[0;32m'
  RED='\033[0;31m'
  YELLOW='\033[0;33m'
  CYAN='\033[0;36m'
  BOLD='\033[1m'
  RESET='\033[0m'
else
  GREEN=''
  RED=''
  YELLOW=''
  CYAN=''
  BOLD=''
  RESET=''
fi

# --- Logging functions -------------------------------------------------------
info()    { printf "${GREEN}[INFO]${RESET}  %s\n" "$*"; }
warn()    { printf "${YELLOW}[WARN]${RESET}  %s\n" "$*"; }
error()   { printf "${RED}[ERROR]${RESET} %s\n" "$*" >&2; }
dry()     { printf "${CYAN}[DRY RUN]${RESET} %s\n" "$*"; }

PASS_COUNT=0
FAIL_COUNT=0

pass() {
  PASS_COUNT=$((PASS_COUNT + 1))
  printf "  ${GREEN}PASS${RESET} %s\n" "$1"
}

fail() {
  FAIL_COUNT=$((FAIL_COUNT + 1))
  printf "  ${RED}FAIL${RESET} %s\n" "$1"
}

section() {
  printf "\n${BOLD}=== %s ===${RESET}\n" "$1"
}

# =============================================================================
# Frontmatter helpers
# =============================================================================

extract_frontmatter() {
  sed -n '/^---$/,/^---$/p' "$1" | sed '1d;$d'
}

has_frontmatter_field() {
  extract_frontmatter "$1" | grep -q "^${2}:"
}

get_frontmatter_field() {
  extract_frontmatter "$1" | grep "^${2}:" | sed "s/^${2}:[[:space:]]*//"
}

# =============================================================================
# File operation helpers
# =============================================================================

backup_file() {
  local file="$1"
  [ -f "$file" ] || return 0

  local backup="${file}.bak.$(date +%s)"
  cp "$file" "$backup"

  local manifest_dir
  manifest_dir="$(dirname "$BACKUP_MANIFEST")"
  if [ ! -d "$manifest_dir" ]; then
    mkdir -p "$manifest_dir"
  fi

  echo "${backup}:${file}" >> "$BACKUP_MANIFEST"
  info "Backed up: $file -> $backup"
}

install_file() {
  local src="$1"
  local dst="$2"

  if [ "$DRY_RUN" = "true" ]; then
    dry "Would copy: $src -> $dst"
    if [ -f "$dst" ]; then
      dry "File exists, showing diff:"
      diff "$dst" "$src" 2>/dev/null || true
    fi
    return 0
  fi

  local dst_dir
  dst_dir="$(dirname "$dst")"
  if [ ! -d "$dst_dir" ]; then
    mkdir -p "$dst_dir"
    info "Created directory: $dst_dir"
  fi

  backup_file "$dst"
  cp "$src" "$dst"
  info "Installed: $dst"
}

install_file_executable() {
  local src="$1"
  local dst="$2"

  install_file "$src" "$dst"

  if [ "$DRY_RUN" = "true" ]; then
    dry "Would make executable: $dst"
    return 0
  fi

  chmod +x "$dst"
}

show_diff() {
  local src="$1"
  local dst="$2"

  if [ -f "$dst" ]; then
    echo ""
    echo "--- Diff: $dst (existing) vs $src (new) ---"
    diff "$dst" "$src" 2>/dev/null || true
    echo "--- End diff ---"
    echo ""
  fi
}

rollback() {
  if [ ! -f "$BACKUP_MANIFEST" ]; then
    warn "No backup manifest found at: $BACKUP_MANIFEST"
    return 1
  fi

  info "Reading backup manifest: $BACKUP_MANIFEST"

  local count=0
  while IFS=: read -r backup_path original_path; do
    [ -z "$backup_path" ] && continue

    if [ "$DRY_RUN" = "true" ]; then
      dry "Would restore: $backup_path -> $original_path"
      count=$((count + 1))
      continue
    fi

    if [ -f "$backup_path" ]; then
      cp "$backup_path" "$original_path"
      rm "$backup_path"
      info "Restored: $original_path (from $backup_path)"
      count=$((count + 1))
    else
      warn "Backup file missing, skipping: $backup_path"
    fi
  done < "$BACKUP_MANIFEST"

  if [ "$DRY_RUN" != "true" ]; then
    rm "$BACKUP_MANIFEST"
    info "Removed backup manifest"
  fi

  info "Rollback complete: $count file(s) restored"
}

# =============================================================================
# Manifest operations
# =============================================================================

manifest_path() {
  echo "$HOME/.claude/.agent-templates-manifest"
}

manifest_write() {
  local installed_at="$1"
  local updated_at="$2"
  local repo_path="$3"
  local repo_commit="$4"
  local comp_rules="$5"
  local comp_skills="$6"
  local comp_hooks="$7"
  local target_dir="$8"

  local mpath
  mpath="$(manifest_path)"
  local mdir
  mdir="$(dirname "$mpath")"
  if [ ! -d "$mdir" ]; then
    mkdir -p "$mdir"
  fi

  if command -v jq >/dev/null 2>&1; then
    jq -n \
      --arg ia "$installed_at" \
      --arg ua "$updated_at" \
      --arg rp "$repo_path" \
      --arg rc "$repo_commit" \
      --argjson cr "$comp_rules" \
      --argjson cs "$comp_skills" \
      --argjson ch "$comp_hooks" \
      --arg td "$target_dir" \
      '{
        installed_at: $ia,
        updated_at: $ua,
        repo_path: $rp,
        repo_commit: $rc,
        components: { rules: $cr, skills: $cs, hooks: $ch },
        target_dir: $td
      }' > "$mpath"
  else
    cat > "$mpath" <<KVEOF
installed_at=${installed_at}
updated_at=${updated_at}
repo_path=${repo_path}
repo_commit=${repo_commit}
components_rules=${comp_rules}
components_skills=${comp_skills}
components_hooks=${comp_hooks}
target_dir=${target_dir}
KVEOF
  fi
}

manifest_read_field() {
  local field="$1"
  local mpath
  mpath="$(manifest_path)"

  if [ ! -f "$mpath" ]; then
    return 1
  fi

  if command -v jq >/dev/null 2>&1; then
    # Handle nested fields like components.rules
    jq -r ".${field} // empty" "$mpath" 2>/dev/null
  else
    # Flatten dotted paths: components.rules -> components_rules
    local flat_field
    flat_field="$(echo "$field" | tr '.' '_')"
    grep "^${flat_field}=" "$mpath" 2>/dev/null | sed "s/^${flat_field}=//"
  fi
}

manifest_clear() {
  local mpath
  mpath="$(manifest_path)"
  if [ -f "$mpath" ]; then
    rm "$mpath"
    info "Removed component manifest"
  fi
}

# =============================================================================
# Component installers
# =============================================================================

install_rules() {
  local rules_src="${SCRIPT_DIR}/rules"
  local rules_dst="${TARGET_DIR}/.claude/rules"

  echo ""
  printf "${BOLD}Installing Language Rules${RESET}\n"
  echo "  Source: $rules_src"
  echo "  Target: $rules_dst"
  echo ""

  # Refuse to install rules into the template repo itself. Rules are
  # per-project; installing them into agent-templates/.claude/rules/ is
  # always a mistake (the teammate's actual project gets nothing).
  if [ "$TARGET_DIR" = "$SCRIPT_DIR" ]; then
    warn "Refusing to install rules into the template repo (TARGET_DIR == SCRIPT_DIR)."
    echo "  Rules are per-project. To install them, run from your project directory:"
    echo "    cd <your-project> && $SCRIPT_DIR/install.sh"
    echo "  or pass --target:"
    echo "    $SCRIPT_DIR/at install --target=/path/to/your/project --non-interactive --all"
    return 0
  fi

  if [ ! -d "$rules_src" ]; then
    warn "Rules source directory not found: $rules_src"
    return 0
  fi

  local found_rules="false"
  for rule_file in "$rules_src"/*.md; do
    [ -f "$rule_file" ] || continue
    found_rules="true"

    local filename
    filename="$(basename "$rule_file")"
    local dst="${rules_dst}/${filename}"

    if [ -f "$dst" ] && [ "$NON_INTERACTIVE" != "true" ] && [ "$DRY_RUN" != "true" ]; then
      show_diff "$rule_file" "$dst"
      printf "  File exists: %s. Overwrite? [y/N] " "$filename"
      read -r answer
      case "$answer" in
        [yY]|[yY][eE][sS])
          install_file "$rule_file" "$dst"
          ;;
        *)
          info "Skipped: $filename"
          ;;
      esac
    else
      install_file "$rule_file" "$dst"
    fi
  done

  if [ "$found_rules" = "false" ]; then
    warn "No rule files found in $rules_src"
  fi
}

install_skills() {
  local skills_src="${SCRIPT_DIR}/skills"
  local skills_dst="${HOME}/.claude/skills"

  echo ""
  printf "${BOLD}Installing Skills${RESET}\n"
  echo "  Source: $skills_src"
  echo "  Target: $skills_dst"
  echo ""

  if [ ! -d "$skills_src" ]; then
    warn "Skills source directory not found: $skills_src"
    return 0
  fi

  local found_skills="false"
  for skill_dir in "$skills_src"/*/; do
    [ -d "$skill_dir" ] || continue

    local skill_name
    skill_name="$(basename "$skill_dir")"

    local has_content="false"
    for item in "$skill_dir"*; do
      local item_name
      item_name="$(basename "$item")"
      if [ "$item_name" != ".gitkeep" ]; then
        has_content="true"
        break
      fi
    done

    if [ "$has_content" = "false" ]; then
      info "Skipping empty skill: $skill_name"
      continue
    fi

    found_skills="true"
    local dst_skill_dir="${skills_dst}/${skill_name}"

    if [ "$DRY_RUN" = "true" ]; then
      dry "Would create directory: $dst_skill_dir"
    else
      if [ ! -d "$dst_skill_dir" ]; then
        mkdir -p "$dst_skill_dir"
        info "Created directory: $dst_skill_dir"
      fi
    fi

    for skill_file in "$skill_dir"*; do
      [ -f "$skill_file" ] || continue
      local fname
      fname="$(basename "$skill_file")"
      [ "$fname" = ".gitkeep" ] && continue

      install_file "$skill_file" "${dst_skill_dir}/${fname}"
    done
  done

  if [ "$found_skills" = "false" ]; then
    warn "No skills with content found in $skills_src"
  fi
}

install_hooks() {
  local hooks_src="${SCRIPT_DIR}/hooks"
  local hooks_dst="${HOME}/.claude/hooks"
  local settings_src="${SCRIPT_DIR}/templates/settings-hooks.json"
  local settings_dst="${HOME}/.claude/settings.json"

  echo ""
  printf "${BOLD}Installing Hooks${RESET}\n"
  echo "  Hook source: $hooks_src"
  echo "  Hook target: $hooks_dst"
  echo "  Settings:    $settings_dst"
  echo ""

  if [ ! -d "$hooks_src" ]; then
    warn "Hooks source directory not found: $hooks_src"
    return 0
  fi

  for hook_file in "$hooks_src"/*.sh; do
    [ -f "$hook_file" ] || continue
    local filename
    filename="$(basename "$hook_file")"
    install_file_executable "$hook_file" "${hooks_dst}/${filename}"
  done

  if [ -f "$settings_src" ]; then
    echo ""
    info "Merging hook configuration into settings.json..."

    if [ "$DRY_RUN" = "true" ]; then
      dry "Would merge $settings_src into $settings_dst"
      if [ -f "$settings_dst" ]; then
        dry "Existing settings.json found, would deep-merge"
      else
        dry "No existing settings.json, would create new"
      fi
      return 0
    fi

    if command -v jq >/dev/null 2>&1; then
      if [ -f "$settings_dst" ]; then
        backup_file "$settings_dst"
        # Merge preserves all top-level keys from the destination and
        # concatenates per-event hook arrays instead of replacing them.
        # Dedup keys on (matcher, hooks) so re-installs stay idempotent.
        local merged
        merged="$(jq -s '
          .[0] as $dst | .[1] as $srcV |
          $dst | .hooks = (
            ($dst.hooks // {}) as $dh |
            ($srcV.hooks // {}) as $sh |
            ((($dh | keys) + ($sh | keys)) | unique) as $events |
            reduce $events[] as $e ({};
              .[$e] = (
                (($dh[$e] // []) + ($sh[$e] // []))
                | unique_by({matcher: (.matcher // ""), hooks: .hooks})
              )
            )
          )
        ' "$settings_dst" "$settings_src")"
        echo "$merged" > "$settings_dst"
        info "Merged hook config into existing settings.json (existing hook arrays preserved)"
      else
        local settings_dir
        settings_dir="$(dirname "$settings_dst")"
        if [ ! -d "$settings_dir" ]; then
          mkdir -p "$settings_dir"
        fi
        cp "$settings_src" "$settings_dst"
        info "Created settings.json with hook configuration"
      fi
    else
      warn "jq not found — cannot auto-merge settings.json"
      echo ""
      echo "  Please manually merge the following into $settings_dst:"
      echo ""
      echo "  --- settings-hooks.json contents ---"
      cat "$settings_src"
      echo ""
      echo "  --- end ---"
      echo ""
      echo "  Install jq for automatic merging: brew install jq (macOS) or apt install jq (Linux)"
    fi
  fi
}

# =============================================================================
# Validation functions
# =============================================================================

validate_skills() {
  section "Skills"

  local skill_files
  skill_files=$(find "$SCRIPT_DIR/skills" -path "*/SKILL.md" -type f 2>/dev/null | sort)

  if [ -z "$skill_files" ]; then
    warn "No SKILL.md files found"
    return
  fi

  local old_ifs="$IFS"
  IFS=$'\n'
  for skill_file in $skill_files; do
    IFS="$old_ifs"
    local skill_dir
    skill_dir=$(dirname "$skill_file")
    local skill_name
    skill_name=$(basename "$skill_dir")

    if has_frontmatter_field "$skill_file" "name"; then
      pass "$skill_name: has 'name' field"
    else
      fail "$skill_name: missing 'name' frontmatter field"
    fi

    if has_frontmatter_field "$skill_file" "description"; then
      pass "$skill_name: has 'description' field"

      local desc
      desc=$(get_frontmatter_field "$skill_file" "description")
      case "$desc" in
        "Use when"*)
          pass "$skill_name: description starts with 'Use when'"
          ;;
        *)
          fail "$skill_name: description should start with 'Use when', got: $(echo "$desc" | head -c 40)..."
          ;;
      esac
    else
      fail "$skill_name: missing 'description' frontmatter field"
    fi

    local other_md
    other_md=$(find "$skill_dir" -maxdepth 1 -name "*.md" -not -name "SKILL.md" -type f 2>/dev/null)
    if [ -n "$other_md" ]; then
      local old_ifs2="$IFS"
      IFS=$'\n'
      for md_file in $other_md; do
        IFS="$old_ifs2"
        if [ -f "$md_file" ]; then
          pass "$skill_name: prompt template $(basename "$md_file") exists"
        fi
      done
      IFS="$old_ifs2"
    fi
  done
  IFS="$old_ifs"
}

validate_rules() {
  section "Rules"

  local rule_files
  rule_files=$(find "$SCRIPT_DIR/rules" -name "*.md" -type f 2>/dev/null | sort)

  if [ -z "$rule_files" ]; then
    warn "No rule .md files found"
    return
  fi

  local old_ifs="$IFS"
  IFS=$'\n'
  for rule_file in $rule_files; do
    IFS="$old_ifs"
    local rule_name
    rule_name=$(basename "$rule_file")

    if has_frontmatter_field "$rule_file" "paths"; then
      pass "$rule_name: has 'paths' field"

      local paths_value
      paths_value=$(get_frontmatter_field "$rule_file" "paths")

      case "$paths_value" in
        "["*"]")
          fail "$rule_name: paths uses YAML array format, should use comma-separated quoted strings"
          ;;
        *)
          if echo "$paths_value" | grep -q '"'; then
            pass "$rule_name: paths uses comma-separated format"
          else
            fail "$rule_name: paths values should be quoted strings"
          fi
          ;;
      esac
    else
      fail "$rule_name: missing 'paths' frontmatter field"
    fi
  done
  IFS="$old_ifs"
}

validate_hooks() {
  section "Hooks"

  local hook_files
  hook_files=$(find "$SCRIPT_DIR/hooks" -name "*.sh" -type f 2>/dev/null | sort)

  if [ -z "$hook_files" ]; then
    warn "No hook .sh files found"
    return
  fi

  local old_ifs="$IFS"
  IFS=$'\n'
  for hook_file in $hook_files; do
    IFS="$old_ifs"
    local hook_name
    hook_name=$(basename "$hook_file")

    if [ -x "$hook_file" ]; then
      pass "$hook_name: is executable"
    else
      fail "$hook_name: is not executable (run: chmod +x $hook_file)"
    fi

    local first_line
    first_line=$(head -1 "$hook_file")
    if [ "$first_line" = "#!/usr/bin/env bash" ]; then
      pass "$hook_name: has correct shebang"
    else
      fail "$hook_name: shebang should be '#!/usr/bin/env bash', got: $first_line"
    fi

    if command -v shellcheck >/dev/null 2>&1; then
      if shellcheck --severity=warning --shell=bash "$hook_file" >/dev/null 2>&1; then
        pass "$hook_name: shellcheck passed"
      else
        fail "$hook_name: shellcheck warnings/errors found"
        shellcheck --severity=warning --shell=bash "$hook_file" 2>&1 | head -20 | while IFS= read -r line; do
          printf "         %s\n" "$line"
        done
      fi
    else
      warn "$hook_name: shellcheck not installed, skipping lint"
    fi

    case "$hook_name" in
      auto-approve.sh)
        if command -v jq >/dev/null 2>&1; then
          local mock_input='{"tool_name":"Read","tool_input":{"file_path":"/tmp/test.txt"}}'
          local output
          output=$(echo "$mock_input" | "$hook_file" 2>/dev/null) || true
          if [ -n "$output" ]; then
            if echo "$output" | jq . >/dev/null 2>&1; then
              pass "$hook_name: mock input produces valid JSON output"
            else
              fail "$hook_name: output is not valid JSON: $output"
            fi
          else
            fail "$hook_name: no output for known safe tool 'Read'"
          fi

          local mock_unsafe='{"tool_name":"Bash","tool_input":{"command":"rm -rf /"}}'
          local unsafe_output
          unsafe_output=$(echo "$mock_unsafe" | "$hook_file" 2>/dev/null) || true
          if [ -z "$unsafe_output" ]; then
            pass "$hook_name: no output for non-safe tool 'Bash'"
          else
            fail "$hook_name: should not produce output for non-safe tool, got: $unsafe_output"
          fi
        else
          warn "$hook_name: jq not installed, skipping mock test"
        fi
        ;;
      notify-slack.sh)
        if [ -n "${CLAUDE_SLACK_WEBHOOK_URL:-}" ]; then
          pass "$hook_name: CLAUDE_SLACK_WEBHOOK_URL is set"
        else
          warn "$hook_name: CLAUDE_SLACK_WEBHOOK_URL is not set (notifications will be silent)"
        fi

        local notify_output
        notify_output=$(CLAUDE_SLACK_WEBHOOK_URL="" "$hook_file" stop 2>&1) || true
        if [ -z "$notify_output" ]; then
          pass "$hook_name: exits silently without webhook URL"
        else
          fail "$hook_name: should be silent without webhook URL, got output: $notify_output"
        fi
        ;;
      check-github-issues.sh)
        if command -v jq >/dev/null 2>&1; then
          # The hook short-circuits when the environment cannot act on GitHub
          # issues (no gh, no gh auth, or no github.com remote). Skip the
          # EnterPlanMode output assertion in that case — otherwise the
          # validator fails on exactly the hosts the guard exists to help.
          if ! command -v gh >/dev/null 2>&1 \
             || ! gh auth status >/dev/null 2>&1 \
             || ! git -C "$SCRIPT_DIR" remote -v 2>/dev/null | grep -q 'github\.com'; then
            warn "$hook_name: gh/github remote unavailable, skipping EnterPlanMode mock test"
          else
            local plan_input='{"tool_name":"EnterPlanMode","tool_result":{}}'
            local plan_output
            plan_output=$(echo "$plan_input" | "$hook_file" 2>/dev/null) || true
            if [ -n "$plan_output" ]; then
              if echo "$plan_output" | jq -e '.hookSpecificOutput.systemMessage' >/dev/null 2>&1; then
                pass "$hook_name: EnterPlanMode input produces systemMessage"
              else
                fail "$hook_name: output missing hookSpecificOutput.systemMessage: $plan_output"
              fi
            else
              fail "$hook_name: no output for EnterPlanMode input"
            fi
          fi

          # Non-EnterPlanMode input must always produce no output — the new
          # guard exits before the tool_name check so this remains silent.
          local other_input='{"tool_name":"Read","tool_input":{"file_path":"/tmp/test"}}'
          local other_output
          other_output=$(echo "$other_input" | "$hook_file" 2>/dev/null) || true
          if [ -z "$other_output" ]; then
            pass "$hook_name: silent for non-EnterPlanMode tool"
          else
            fail "$hook_name: should be silent for non-EnterPlanMode tool, got: $other_output"
          fi
        else
          warn "$hook_name: jq not installed, skipping mock test"
        fi
        ;;
    esac
  done
  IFS="$old_ifs"
}

validate_settings() {
  section "Settings"

  local settings_file="$SCRIPT_DIR/templates/settings-hooks.json"

  if [ ! -f "$settings_file" ]; then
    fail "settings-hooks.json: file not found"
    return
  fi

  if command -v jq >/dev/null 2>&1; then
    if jq . "$settings_file" >/dev/null 2>&1; then
      pass "settings-hooks.json: valid JSON"
    else
      fail "settings-hooks.json: invalid JSON"
      return
    fi

    local known_events="Notification Stop PreToolUse PostToolUse SessionStart UserPromptSubmit"
    local events
    events=$(jq -r '.hooks | keys[]' "$settings_file" 2>/dev/null) || true

    if [ -z "$events" ]; then
      fail "settings-hooks.json: no hook events found"
    else
      local old_ifs="$IFS"
      IFS=$'\n'
      for event in $events; do
        IFS="$old_ifs"
        local found=false
        for known in $known_events; do
          if [ "$event" = "$known" ]; then
            found=true
            break
          fi
        done
        if [ "$found" = true ]; then
          pass "settings-hooks.json: event '$event' is valid"
        else
          fail "settings-hooks.json: unknown event type '$event'"
        fi
      done
      IFS="$old_ifs"
    fi
  else
    warn "settings-hooks.json: jq not installed, skipping validation"
  fi
}

validate_smoke() {
  section "Smoke Test"

  local tmpdir
  tmpdir=$(mktemp -d)
  # shellcheck disable=SC2064
  trap "rm -rf '$tmpdir'" EXIT

  # Pre-seed a sentinel settings.json to exercise the merge path (fresh tmpdir
  # would otherwise hit only the "create new" branch and never test the merge).
  mkdir -p "$tmpdir/.claude"
  cat > "$tmpdir/.claude/settings.json" <<'EOF'
{"hooks":{"Notification":[{"matcher":"","hooks":[{"type":"command","command":"ECHO_PRESERVED"}]}]}}
EOF

  printf "  Running installer into temp dir: %s\n" "$tmpdir"
  local install_output
  if install_output=$(HOME="$tmpdir" "$SCRIPT_DIR/at" install --target="$tmpdir" --non-interactive --all 2>&1); then
    pass "at install exited successfully"
  else
    fail "at install exited with non-zero status"
    printf "         %s\n" "$install_output"
    return
  fi

  local expected_rules="python.md typescript.md rust.md cpp.md"
  for rule in $expected_rules; do
    if [ -f "$tmpdir/.claude/rules/$rule" ]; then
      pass "rule installed: $rule"
    else
      fail "rule missing: $tmpdir/.claude/rules/$rule"
    fi
  done

  local expected_skills="clean-code-planner python-coding-rules implement-orchestrator plan-codebase plan-tests implement-parallel review-parallel multi-review make-pr"
  for skill in $expected_skills; do
    if [ -f "$tmpdir/.claude/skills/$skill/SKILL.md" ]; then
      pass "skill installed: $skill/SKILL.md"
    else
      fail "skill missing: $tmpdir/.claude/skills/$skill/SKILL.md"
    fi
  done

  local expected_hooks="auto-approve.sh check-github-issues.sh notify-slack.sh"
  for hook in $expected_hooks; do
    if [ -f "$tmpdir/.claude/hooks/$hook" ]; then
      pass "hook installed: $hook"
      if [ -x "$tmpdir/.claude/hooks/$hook" ]; then
        pass "hook executable: $hook"
      else
        fail "hook not executable: $hook"
      fi
    else
      fail "hook missing: $tmpdir/.claude/hooks/$hook"
    fi
  done

  if [ -f "$tmpdir/.claude/settings.json" ]; then
    pass "settings.json installed"

    if command -v jq >/dev/null 2>&1; then
      if jq . "$tmpdir/.claude/settings.json" >/dev/null 2>&1; then
        pass "settings.json is valid JSON"
      else
        fail "settings.json is not valid JSON"
      fi

      # Merge-path assertions: the pre-seeded sentinel (ECHO_PRESERVED) must
      # coexist with the template's Slack hook after the merge.
      if jq -e '[.hooks.Notification[].hooks[] | select(.command == "ECHO_PRESERVED")] | length > 0' \
           "$tmpdir/.claude/settings.json" >/dev/null 2>&1; then
        pass "settings merge: existing Notification hook preserved"
      else
        fail "settings merge: existing Notification hook was lost (merge replaced the array)"
      fi

      if jq -e '[.hooks.Notification[].hooks[] | select(.command | test("notify-slack"))] | length > 0' \
           "$tmpdir/.claude/settings.json" >/dev/null 2>&1; then
        pass "settings merge: template notify-slack hook is present"
      else
        fail "settings merge: template notify-slack hook is missing"
      fi

      # Idempotency: re-running the installer must not duplicate the sentinel.
      HOME="$tmpdir" "$SCRIPT_DIR/at" install --target="$tmpdir" --non-interactive --all >/dev/null 2>&1 || true
      local preserved_count
      preserved_count=$(jq '[.hooks.Notification[].hooks[] | select(.command == "ECHO_PRESERVED")] | length' \
                           "$tmpdir/.claude/settings.json" 2>/dev/null || echo "0")
      if [ "$preserved_count" = "1" ]; then
        pass "settings merge: idempotent re-install keeps sentinel exactly once"
      else
        fail "settings merge: re-install produced $preserved_count sentinel entries (expected 1)"
      fi
    else
      warn "jq not installed, skipping JSON validation of settings.json"
    fi
  else
    fail "settings.json missing: $tmpdir/.claude/settings.json"
  fi

  rm -rf "$tmpdir"
  trap - EXIT
}

# =============================================================================
# Subcommand: install
# =============================================================================

cmd_install() {
  DRY_RUN="false"
  TARGET_DIR=""
  NON_INTERACTIVE="false"
  INSTALL_ALL="false"
  BACKUP_MANIFEST=""

  for arg in "$@"; do
    case "$arg" in
      --dry-run)
        DRY_RUN="true"
        ;;
      --target=*)
        TARGET_DIR="${arg#--target=}"
        ;;
      --non-interactive)
        NON_INTERACTIVE="true"
        ;;
      --all)
        INSTALL_ALL="true"
        ;;
      --help|-h)
        echo "Usage: at install [OPTIONS]"
        echo ""
        echo "Options:"
        echo "  --dry-run            Show what would be done without making changes"
        echo "  --target=<path>      Target project directory (default: current directory)"
        echo "  --non-interactive    Do not prompt for input"
        echo "  --all                Install all components"
        echo "  -h, --help           Show this help message"
        return 0
        ;;
      *)
        error "Unknown option: $arg"
        echo "Run 'at install --help' for usage."
        return 1
        ;;
    esac
  done

  if [ -z "$TARGET_DIR" ]; then
    TARGET_DIR="$(pwd)"
  fi

  if [ ! -d "$TARGET_DIR" ]; then
    error "Target directory does not exist: $TARGET_DIR"
    return 1
  fi

  TARGET_DIR="$( cd "$TARGET_DIR" && pwd )"
  BACKUP_MANIFEST="${TARGET_DIR}/.claude/.install-backup-manifest"

  echo ""
  printf "${BOLD}Claude Code Agent Templates Installer${RESET}\n"
  echo "======================================"
  echo ""
  echo "  Target: $TARGET_DIR"
  if [ "$DRY_RUN" = "true" ]; then
    echo "  Mode:   DRY RUN (no changes will be made)"
  fi
  echo ""

  # Track which components get installed for the manifest
  local did_rules="false"
  local did_skills="false"
  local did_hooks="false"

  if [ "$INSTALL_ALL" = "true" ]; then
    install_rules
    install_skills
    install_hooks
    did_rules="true"
    did_skills="true"
    did_hooks="true"

    echo ""
    echo "======================================"
    if [ "$DRY_RUN" = "true" ]; then
      dry "Dry run complete — no files were changed"
    else
      _write_manifest "$did_rules" "$did_skills" "$did_hooks"
      info "Installation complete!"
      echo ""
      echo "  Next steps:"
      echo "    1. Set CLAUDE_SLACK_WEBHOOK_URL for Slack notifications"
      echo "    2. Add 'Bash(gh issue:*)' to permissions for GitHub issue integration"
      echo "    3. Review .claude/rules/ for language-specific conventions"
    fi
    echo ""
    return 0
  fi

  if [ "$NON_INTERACTIVE" = "true" ]; then
    error "Non-interactive mode requires --all or specific component flags"
    echo "  Usage: at install --non-interactive --all"
    return 1
  fi

  # Interactive menu
  while true; do
    echo ""
    echo "  What would you like to install?"
    echo ""
    echo "    [1] Language Rules (python, typescript, rust, cpp)"
    echo "    [2] Skills (agentic workflow pipeline)"
    echo "    [3] Hooks (Slack notifications, auto-approve)"
    echo "    [4] Everything"
    echo "    [0] Exit"
    echo ""
    printf "  Select options (comma-separated): "
    read -r choices

    choices="$(echo "$choices" | tr -d ' ')"

    if [ -z "$choices" ]; then
      continue
    fi

    OLD_IFS="$IFS"
    IFS=","
    set -- $choices
    IFS="$OLD_IFS"

    local_exit="false"
    for choice in "$@"; do
      case "$choice" in
        0)
          local_exit="true"
          ;;
        1)
          install_rules
          did_rules="true"
          ;;
        2)
          install_skills
          did_skills="true"
          ;;
        3)
          install_hooks
          did_hooks="true"
          ;;
        4)
          install_rules
          install_skills
          install_hooks
          did_rules="true"
          did_skills="true"
          did_hooks="true"
          ;;
        *)
          warn "Unknown option: $choice"
          ;;
      esac
    done

    if [ "$local_exit" = "true" ]; then
      break
    fi

    echo ""
    echo "======================================"
    if [ "$DRY_RUN" = "true" ]; then
      dry "Dry run — no files were changed"
    else
      info "Done! Select more options or [0] to exit."
    fi
  done

  if [ "$DRY_RUN" != "true" ]; then
    _write_manifest "$did_rules" "$did_skills" "$did_hooks"
  fi

  echo ""
  info "Goodbye!"
}

_write_manifest() {
  local did_rules="$1"
  local did_skills="$2"
  local did_hooks="$3"

  local now
  now="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  local commit
  commit="$(git -C "$SCRIPT_DIR" rev-parse --short HEAD 2>/dev/null || echo "unknown")"

  # Read existing manifest for installed_at, or use now
  local installed_at
  installed_at="$(manifest_read_field "installed_at" 2>/dev/null || echo "")"
  if [ -z "$installed_at" ]; then
    installed_at="$now"
  fi

  manifest_write "$installed_at" "$now" "$SCRIPT_DIR" "$commit" \
    "$did_rules" "$did_skills" "$did_hooks" "$TARGET_DIR"
}

# =============================================================================
# Subcommand: update
# =============================================================================

cmd_update() {
  local skip_pull="false"
  local update_all="false"

  for arg in "$@"; do
    case "$arg" in
      --local)
        skip_pull="true"
        ;;
      --all)
        update_all="true"
        ;;
      --help|-h)
        echo "Usage: at update [OPTIONS]"
        echo ""
        echo "Options:"
        echo "  --local    Skip git pull, reinstall from local repo"
        echo "  --all      Reinstall all components (override manifest)"
        echo "  -h, --help Show this help message"
        return 0
        ;;
      *)
        error "Unknown option: $arg"
        return 1
        ;;
    esac
  done

  local mpath
  mpath="$(manifest_path)"
  if [ ! -f "$mpath" ]; then
    error "No installation manifest found. Run 'at install' first."
    return 1
  fi

  local repo_path
  repo_path="$(manifest_read_field "repo_path")"
  TARGET_DIR="$(manifest_read_field "target_dir")"
  BACKUP_MANIFEST="${TARGET_DIR}/.claude/.install-backup-manifest"
  DRY_RUN="false"
  NON_INTERACTIVE="true"

  if [ -z "$repo_path" ] || [ -z "$TARGET_DIR" ]; then
    error "Manifest is missing required fields (repo_path, target_dir)"
    return 1
  fi

  echo ""
  printf "${BOLD}Claude Code Agent Templates — Update${RESET}\n"
  echo "======================================"
  echo ""
  echo "  Repository: $repo_path"
  echo "  Target:     $TARGET_DIR"
  echo ""

  if [ "$skip_pull" = "false" ]; then
    info "Pulling latest changes..."
    if git -C "$repo_path" pull --ff-only 2>&1; then
      info "Repository updated"
    else
      error "git pull --ff-only failed. Use --local to skip, or resolve manually."
      return 1
    fi
  else
    info "Skipping git pull (--local)"
  fi

  local comp_rules comp_skills comp_hooks
  if [ "$update_all" = "true" ]; then
    comp_rules="true"
    comp_skills="true"
    comp_hooks="true"
  else
    comp_rules="$(manifest_read_field "components.rules" 2>/dev/null || echo "false")"
    comp_skills="$(manifest_read_field "components.skills" 2>/dev/null || echo "false")"
    comp_hooks="$(manifest_read_field "components.hooks" 2>/dev/null || echo "false")"
  fi

  echo ""
  info "Reinstalling components..."

  if [ "$comp_rules" = "true" ]; then
    install_rules
  fi

  if [ "$comp_skills" = "true" ]; then
    install_skills
  fi

  if [ "$comp_hooks" = "true" ]; then
    install_hooks
  fi

  # Update manifest with new commit and timestamp
  local now
  now="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  local installed_at
  installed_at="$(manifest_read_field "installed_at" 2>/dev/null || echo "$now")"
  local commit
  commit="$(git -C "$repo_path" rev-parse --short HEAD 2>/dev/null || echo "unknown")"

  manifest_write "$installed_at" "$now" "$repo_path" "$commit" \
    "$comp_rules" "$comp_skills" "$comp_hooks" "$TARGET_DIR"

  echo ""
  info "Update complete!"
}

# =============================================================================
# Subcommand: uninstall
# =============================================================================

cmd_uninstall() {
  DRY_RUN="false"
  TARGET_DIR=""
  local deep="false"

  for arg in "$@"; do
    case "$arg" in
      --deep)
        deep="true"
        ;;
      --dry-run)
        DRY_RUN="true"
        ;;
      --target=*)
        TARGET_DIR="${arg#--target=}"
        ;;
      --help|-h)
        echo "Usage: at uninstall [OPTIONS]"
        echo ""
        echo "Options:"
        echo "  --deep           Also remove plans/, impl-temp/, code-spec.md, test-plan.md"
        echo "  --dry-run        Show what would be done without making changes"
        echo "  --target=<path>  Target project directory (reads from manifest if omitted)"
        echo "  -h, --help       Show this help message"
        return 0
        ;;
      *)
        error "Unknown option: $arg"
        return 1
        ;;
    esac
  done

  # Resolve target from manifest if not provided
  if [ -z "$TARGET_DIR" ]; then
    TARGET_DIR="$(manifest_read_field "target_dir" 2>/dev/null || echo "")"
  fi

  if [ -z "$TARGET_DIR" ]; then
    error "No target directory. Provide --target= or run 'at install' first."
    return 1
  fi

  TARGET_DIR="$( cd "$TARGET_DIR" && pwd )"
  BACKUP_MANIFEST="${TARGET_DIR}/.claude/.install-backup-manifest"

  echo ""
  printf "${BOLD}Claude Code Agent Templates — Uninstall${RESET}\n"
  echo "========================================"
  echo ""
  echo "  Target:   $TARGET_DIR"
  echo "  Manifest: $BACKUP_MANIFEST"
  echo ""

  if [ "$DRY_RUN" = "true" ]; then
    dry "Preview of rollback:"
    echo ""
  fi

  rollback || true

  if [ "$deep" = "true" ]; then
    echo ""
    info "Deep clean: removing generated files..."

    local deep_targets=(
      "$HOME/.claude/plans"
      "$TARGET_DIR/impl-temp"
      "$TARGET_DIR/code-spec.md"
      "$TARGET_DIR/test-plan.md"
    )

    for target in "${deep_targets[@]}"; do
      if [ -e "$target" ]; then
        if [ "$DRY_RUN" = "true" ]; then
          dry "Would remove: $target"
        else
          rm -rf "$target"
          info "Removed: $target"
        fi
      fi
    done
  fi

  if [ "$DRY_RUN" != "true" ]; then
    manifest_clear
  fi

  echo ""
  info "Uninstall complete"
}

# =============================================================================
# Subcommand: validate
# =============================================================================

cmd_validate() {
  local v_skills=false
  local v_rules=false
  local v_hooks=false
  local v_smoke=false
  local v_settings=false

  for arg in "$@"; do
    case "$arg" in
      --skills)   v_skills=true ;;
      --rules)    v_rules=true ;;
      --hooks)    v_hooks=true ;;
      --smoke)    v_smoke=true ;;
      --settings) v_settings=true ;;
      --help|-h)
        echo "Usage: at validate [OPTIONS]"
        echo ""
        echo "With no flags, validates everything except smoke tests."
        echo ""
        echo "Options:"
        echo "  --skills     Validate skill definitions"
        echo "  --rules      Validate rule files"
        echo "  --hooks      Validate hook scripts"
        echo "  --settings   Validate settings template"
        echo "  --smoke      Run smoke tests (installs into temp dir)"
        echo "  -h, --help   Show this help message"
        return 0
        ;;
      *)
        error "Unknown option: $arg"
        return 1
        ;;
    esac
  done

  # Default: everything except smoke
  if [ "$v_skills" = false ] && [ "$v_rules" = false ] && \
     [ "$v_hooks" = false ] && [ "$v_smoke" = false ] && \
     [ "$v_settings" = false ]; then
    v_skills=true
    v_rules=true
    v_hooks=true
    v_settings=true
  fi

  PASS_COUNT=0
  FAIL_COUNT=0

  printf "${BOLD}agent-templates validation${RESET}\n"

  if [ "$v_skills" = true ]; then
    validate_skills
  fi

  if [ "$v_rules" = true ]; then
    validate_rules
  fi

  if [ "$v_hooks" = true ]; then
    validate_hooks
  fi

  if [ "$v_settings" = true ]; then
    validate_settings
  fi

  if [ "$v_smoke" = true ]; then
    validate_smoke
  fi

  printf "\n${BOLD}--- Summary ---${RESET}\n"
  printf "  ${GREEN}%d passed${RESET}, ${RED}%d failed${RESET}\n" "$PASS_COUNT" "$FAIL_COUNT"

  if [ "$FAIL_COUNT" -gt 0 ]; then
    return 1
  fi
}

# =============================================================================
# Subcommand: status
# =============================================================================

cmd_status() {
  for arg in "$@"; do
    case "$arg" in
      --help|-h)
        echo "Usage: at status"
        echo ""
        echo "Show installation status dashboard."
        return 0
        ;;
      *)
        error "Unknown option: $arg"
        return 1
        ;;
    esac
  done

  echo ""
  printf "${BOLD}Agent Templates Status${RESET}\n"
  echo "======================"
  echo ""

  # --- Installed Components ---
  section "Installed Components"

  local rules_count=0
  if [ -d "$HOME/.claude/rules" ]; then
    for f in "$HOME/.claude/rules"/*.md; do
      [ -f "$f" ] && rules_count=$((rules_count + 1))
    done
  fi
  printf "  Rules:  %d files in ~/.claude/rules/\n" "$rules_count"

  local skills_count=0
  if [ -d "$HOME/.claude/skills" ]; then
    for d in "$HOME/.claude/skills"/*/; do
      [ -d "$d" ] && skills_count=$((skills_count + 1))
    done
  fi
  printf "  Skills: %d dirs in ~/.claude/skills/\n" "$skills_count"

  local hooks_count=0
  if [ -d "$HOME/.claude/hooks" ]; then
    for f in "$HOME/.claude/hooks"/*.sh; do
      [ -f "$f" ] && hooks_count=$((hooks_count + 1))
    done
  fi
  printf "  Hooks:  %d files in ~/.claude/hooks/\n" "$hooks_count"

  # --- Repository ---
  section "Repository"

  local repo_path
  repo_path="$(manifest_read_field "repo_path" 2>/dev/null || echo "")"
  if [ -z "$repo_path" ]; then
    repo_path="$SCRIPT_DIR"
  fi

  printf "  Path:   %s\n" "$repo_path"

  if [ -d "$repo_path/.git" ]; then
    local current_commit
    current_commit="$(git -C "$repo_path" rev-parse --short HEAD 2>/dev/null || echo "unknown")"
    printf "  Commit: %s\n" "$current_commit"

    local current_branch
    current_branch="$(git -C "$repo_path" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown")"
    printf "  Branch: %s\n" "$current_branch"

    # Ahead/behind origin (if remote exists)
    if git -C "$repo_path" remote get-url origin >/dev/null 2>&1; then
      local ahead_behind
      ahead_behind="$(git -C "$repo_path" rev-list --left-right --count "${current_branch}...origin/${current_branch}" 2>/dev/null || echo "")"
      if [ -n "$ahead_behind" ]; then
        local ahead behind
        ahead="$(echo "$ahead_behind" | cut -f1)"
        behind="$(echo "$ahead_behind" | cut -f2)"
        printf "  Status: %s ahead, %s behind origin/%s\n" "$ahead" "$behind" "$current_branch"
      fi
    fi
  else
    printf "  (not a git repository)\n"
  fi

  # --- Last Updated ---
  section "Last Updated"

  local installed_at
  installed_at="$(manifest_read_field "installed_at" 2>/dev/null || echo "")"
  local updated_at
  updated_at="$(manifest_read_field "updated_at" 2>/dev/null || echo "")"

  if [ -n "$installed_at" ]; then
    printf "  Installed: %s\n" "$installed_at"
  else
    printf "  Installed: (no manifest found)\n"
  fi

  if [ -n "$updated_at" ]; then
    printf "  Updated:   %s\n" "$updated_at"
  else
    printf "  Updated:   (no manifest found)\n"
  fi

  # --- Config Health ---
  section "Config Health"

  local settings_file="$HOME/.claude/settings.json"
  if [ -f "$settings_file" ]; then
    if command -v jq >/dev/null 2>&1; then
      if jq . "$settings_file" >/dev/null 2>&1; then
        printf "  settings.json: ${GREEN}valid${RESET}\n"
      else
        printf "  settings.json: ${RED}invalid JSON${RESET}\n"
      fi
    else
      printf "  settings.json: exists (jq not available for validation)\n"
    fi
  else
    printf "  settings.json: ${YELLOW}not found${RESET}\n"
  fi

  if [ -n "${CLAUDE_SLACK_WEBHOOK_URL:-}" ]; then
    printf "  CLAUDE_SLACK_WEBHOOK_URL: ${GREEN}set${RESET}\n"
  else
    printf "  CLAUDE_SLACK_WEBHOOK_URL: ${YELLOW}not set${RESET}\n"
  fi

  if command -v gh >/dev/null 2>&1; then
    if gh auth status >/dev/null 2>&1; then
      printf "  gh auth: ${GREEN}authenticated${RESET}\n"
    else
      printf "  gh auth: ${RED}not authenticated${RESET}\n"
    fi
  else
    printf "  gh auth: ${YELLOW}gh CLI not installed${RESET}\n"
  fi

  echo ""
}

# =============================================================================
# Usage
# =============================================================================

usage() {
  cat <<EOF
at — Unified CLI for Claude Code Agent Templates (v${AT_VERSION})

Usage:
  at <command> [options]

Commands:
  install     Install rules, skills, and hooks
  update      Pull latest and reinstall tracked components
  uninstall   Restore backups and remove installed files
  validate    Validate all agent-templates artifacts
  status      Show installation status dashboard

Options:
  -h, --help      Show this help message
  --version       Show version

Install options:
  --all                Install all components
  --target=<path>      Target project directory (default: cwd)
  --dry-run            Preview changes without writing
  --non-interactive    No prompts

Update options:
  --local    Skip git pull, reinstall from local repo
  --all      Reinstall all components (override manifest)

Uninstall options:
  --deep       Also remove plans/, impl-temp/, code-spec.md, test-plan.md
  --dry-run    Preview changes without writing
  --target=<path>  Target project directory

Validate options:
  --skills     Validate skill definitions
  --rules      Validate rule files
  --hooks      Validate hook scripts
  --settings   Validate settings template
  --smoke      Run smoke tests

Examples:
  at install --all                     Install everything
  at install --dry-run --all           Preview full install
  at update --local                    Reinstall without pulling
  at uninstall --deep --dry-run        Preview deep uninstall
  at validate --smoke                  Run smoke tests
  at status                            Show dashboard
EOF
}

# =============================================================================
# Main dispatch
# =============================================================================

if [ $# -eq 0 ]; then
  usage
  exit 0
fi

command="$1"
shift

case "$command" in
  install)
    cmd_install "$@"
    ;;
  update)
    cmd_update "$@"
    ;;
  uninstall)
    cmd_uninstall "$@"
    ;;
  validate)
    cmd_validate "$@"
    ;;
  status)
    cmd_status "$@"
    ;;
  --help|-h)
    usage
    ;;
  --version)
    echo "at version ${AT_VERSION}"
    ;;
  *)
    error "Unknown command: $command"
    echo "Run 'at --help' for usage."
    exit 1
    ;;
esac
