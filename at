#!/usr/bin/env bash
set -euo pipefail

# =============================================================================
# at — Unified CLI for Claude Code Agent Templates
# =============================================================================
# Merges install.sh and validate.sh into a single script with subcommand
# dispatch. Bash 3.2 compatible (macOS default).
# =============================================================================

# --- Bash version check ------------------------------------------------------
if [[ "${BASH_VERSINFO[0]}" -lt 3 ]]; then
  echo "Error: bash 3.2+ required (found ${BASH_VERSION})"
  exit 1
fi

# --- Resolve script directory ------------------------------------------------
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"

# --- Version -----------------------------------------------------------------
AT_VERSION="0.1.0"

# --- Color helpers (degrade gracefully) --------------------------------------
if [ -t 1 ] && [ "${TERM:-dumb}" != "dumb" ]; then
  GREEN='\033[0;32m'
  RED='\033[0;31m'
  YELLOW='\033[0;33m'
  CYAN='\033[0;36m'
  BOLD='\033[1m'
  RESET='\033[0m'
else
  GREEN=''
  RED=''
  YELLOW=''
  CYAN=''
  BOLD=''
  RESET=''
fi

# --- Logging functions -------------------------------------------------------
info()    { printf "${GREEN}[INFO]${RESET}  %s\n" "$*"; }
warn()    { printf "${YELLOW}[WARN]${RESET}  %s\n" "$*"; }
error()   { printf "${RED}[ERROR]${RESET} %s\n" "$*" >&2; }
dry()     { printf "${CYAN}[DRY RUN]${RESET} %s\n" "$*"; }

PASS_COUNT=0
FAIL_COUNT=0

pass() {
  PASS_COUNT=$((PASS_COUNT + 1))
  printf "  ${GREEN}PASS${RESET} %s\n" "$1"
}

fail() {
  FAIL_COUNT=$((FAIL_COUNT + 1))
  printf "  ${RED}FAIL${RESET} %s\n" "$1"
}

section() {
  printf "\n${BOLD}=== %s ===${RESET}\n" "$1"
}

# =============================================================================
# Frontmatter helpers
# =============================================================================

extract_frontmatter() {
  sed -n '/^---$/,/^---$/p' "$1" | sed '1d;$d'
}

has_frontmatter_field() {
  extract_frontmatter "$1" | grep -q "^${2}:"
}

get_frontmatter_field() {
  extract_frontmatter "$1" | grep "^${2}:" | sed "s/^${2}:[[:space:]]*//"
}

# =============================================================================
# File operation helpers
# =============================================================================

backup_file() {
  local file="$1"
  [ -f "$file" ] || return 0

  local backup="${file}.bak.$(date +%s)"
  cp "$file" "$backup"

  local manifest_dir
  manifest_dir="$(dirname "$BACKUP_MANIFEST")"
  if [ ! -d "$manifest_dir" ]; then
    mkdir -p "$manifest_dir"
  fi

  echo "${backup}:${file}" >> "$BACKUP_MANIFEST"
  info "Backed up: $file -> $backup"
}

install_file() {
  local src="$1"
  local dst="$2"

  if [ "$DRY_RUN" = "true" ]; then
    dry "Would copy: $src -> $dst"
    if [ -f "$dst" ]; then
      dry "File exists, showing diff:"
      diff "$dst" "$src" 2>/dev/null || true
    fi
    return 0
  fi

  local dst_dir
  dst_dir="$(dirname "$dst")"
  if [ ! -d "$dst_dir" ]; then
    mkdir -p "$dst_dir"
    info "Created directory: $dst_dir"
  fi

  backup_file "$dst"
  cp "$src" "$dst"
  info "Installed: $dst"
}

install_file_executable() {
  local src="$1"
  local dst="$2"

  install_file "$src" "$dst"

  if [ "$DRY_RUN" = "true" ]; then
    dry "Would make executable: $dst"
    return 0
  fi

  chmod +x "$dst"
}

show_diff() {
  local src="$1"
  local dst="$2"

  if [ -f "$dst" ]; then
    echo ""
    echo "--- Diff: $dst (existing) vs $src (new) ---"
    diff "$dst" "$src" 2>/dev/null || true
    echo "--- End diff ---"
    echo ""
  fi
}

rollback() {
  if [ ! -f "$BACKUP_MANIFEST" ]; then
    warn "No backup manifest found at: $BACKUP_MANIFEST"
    return 1
  fi

  info "Reading backup manifest: $BACKUP_MANIFEST"

  local count=0
  while IFS=: read -r backup_path original_path; do
    [ -z "$backup_path" ] && continue

    if [ "$DRY_RUN" = "true" ]; then
      dry "Would restore: $backup_path -> $original_path"
      count=$((count + 1))
      continue
    fi

    if [ -f "$backup_path" ]; then
      cp "$backup_path" "$original_path"
      rm "$backup_path"
      info "Restored: $original_path (from $backup_path)"
      count=$((count + 1))
    else
      warn "Backup file missing, skipping: $backup_path"
    fi
  done < "$BACKUP_MANIFEST"

  if [ "$DRY_RUN" != "true" ]; then
    rm "$BACKUP_MANIFEST"
    info "Removed backup manifest"
  fi

  info "Rollback complete: $count file(s) restored"
}

# =============================================================================
# Manifest operations
# =============================================================================

manifest_path() {
  echo "$HOME/.claude/.agent-templates-manifest"
}

manifest_write() {
  local installed_at="$1"
  local updated_at="$2"
  local repo_path="$3"
  local repo_commit="$4"
  local comp_rules="$5"
  local comp_skills="$6"
  local target_dir="$7"

  local mpath
  mpath="$(manifest_path)"
  local mdir
  mdir="$(dirname "$mpath")"
  if [ ! -d "$mdir" ]; then
    mkdir -p "$mdir"
  fi

  if command -v jq >/dev/null 2>&1; then
    jq -n \
      --arg ia "$installed_at" \
      --arg ua "$updated_at" \
      --arg rp "$repo_path" \
      --arg rc "$repo_commit" \
      --argjson cr "$comp_rules" \
      --argjson cs "$comp_skills" \
      --arg td "$target_dir" \
      '{
        installed_at: $ia,
        updated_at: $ua,
        repo_path: $rp,
        repo_commit: $rc,
        components: { rules: $cr, skills: $cs },
        target_dir: $td
      }' > "$mpath"
  else
    cat > "$mpath" <<KVEOF
installed_at=${installed_at}
updated_at=${updated_at}
repo_path=${repo_path}
repo_commit=${repo_commit}
components_rules=${comp_rules}
components_skills=${comp_skills}
target_dir=${target_dir}
KVEOF
  fi
}

manifest_read_field() {
  local field="$1"
  local mpath
  mpath="$(manifest_path)"

  if [ ! -f "$mpath" ]; then
    return 1
  fi

  if command -v jq >/dev/null 2>&1; then
    # Handle nested fields like components.rules
    jq -r ".${field} // empty" "$mpath" 2>/dev/null
  else
    # Flatten dotted paths: components.rules -> components_rules
    local flat_field
    flat_field="$(echo "$field" | tr '.' '_')"
    grep "^${flat_field}=" "$mpath" 2>/dev/null | sed "s/^${flat_field}=//"
  fi
}

manifest_clear() {
  local mpath
  mpath="$(manifest_path)"
  if [ -f "$mpath" ]; then
    rm "$mpath"
    info "Removed component manifest"
  fi
}

# =============================================================================
# Component installers
# =============================================================================

install_rules() {
  local rules_src="${SCRIPT_DIR}/rules"
  local rules_dst="${TARGET_DIR}/.claude/rules"

  echo ""
  printf "${BOLD}Installing Language Rules${RESET}\n"
  echo "  Source: $rules_src"
  echo "  Target: $rules_dst"
  echo ""

  # Refuse to install rules into the template repo itself. Rules are
  # per-project; installing them into agent-templates/.claude/rules/ is
  # always a mistake (the teammate's actual project gets nothing).
  if [ "$TARGET_DIR" = "$SCRIPT_DIR" ]; then
    warn "Refusing to install rules into the template repo (TARGET_DIR == SCRIPT_DIR)."
    echo "  Rules are per-project. To install them, run from your project directory:"
    echo "    cd <your-project> && $SCRIPT_DIR/install.sh"
    echo "  or pass --target:"
    echo "    $SCRIPT_DIR/at install --target=/path/to/your/project --non-interactive --all"
    return 0
  fi

  if [ ! -d "$rules_src" ]; then
    warn "Rules source directory not found: $rules_src"
    return 0
  fi

  local found_rules="false"
  for rule_file in "$rules_src"/*.md; do
    [ -f "$rule_file" ] || continue
    found_rules="true"

    local filename
    filename="$(basename "$rule_file")"
    local dst="${rules_dst}/${filename}"

    if [ -f "$dst" ] && [ "$NON_INTERACTIVE" != "true" ] && [ "$DRY_RUN" != "true" ]; then
      show_diff "$rule_file" "$dst"
      printf "  File exists: %s. Overwrite? [y/N] " "$filename"
      read -r answer
      case "$answer" in
        [yY]|[yY][eE][sS])
          install_file "$rule_file" "$dst"
          ;;
        *)
          info "Skipped: $filename"
          ;;
      esac
    else
      install_file "$rule_file" "$dst"
    fi
  done

  if [ "$found_rules" = "false" ]; then
    warn "No rule files found in $rules_src"
  fi
}

install_skills() {
  local skills_src="${SCRIPT_DIR}/skills"
  local skills_dst="${HOME}/.claude/skills"

  echo ""
  printf "${BOLD}Installing Skills${RESET}\n"
  echo "  Source: $skills_src"
  echo "  Target: $skills_dst"
  echo ""

  if [ ! -d "$skills_src" ]; then
    warn "Skills source directory not found: $skills_src"
    return 0
  fi

  local found_skills="false"
  for skill_dir in "$skills_src"/*/; do
    [ -d "$skill_dir" ] || continue

    local skill_name
    skill_name="$(basename "$skill_dir")"

    local has_content="false"
    for item in "$skill_dir"*; do
      local item_name
      item_name="$(basename "$item")"
      if [ "$item_name" != ".gitkeep" ]; then
        has_content="true"
        break
      fi
    done

    if [ "$has_content" = "false" ]; then
      info "Skipping empty skill: $skill_name"
      continue
    fi

    found_skills="true"
    local dst_skill_dir="${skills_dst}/${skill_name}"

    if [ "$DRY_RUN" = "true" ]; then
      dry "Would create directory: $dst_skill_dir"
    else
      if [ ! -d "$dst_skill_dir" ]; then
        mkdir -p "$dst_skill_dir"
        info "Created directory: $dst_skill_dir"
      fi
    fi

    for skill_file in "$skill_dir"*; do
      [ -f "$skill_file" ] || continue
      local fname
      fname="$(basename "$skill_file")"
      [ "$fname" = ".gitkeep" ] && continue

      install_file "$skill_file" "${dst_skill_dir}/${fname}"
    done
  done

  if [ "$found_skills" = "false" ]; then
    warn "No skills with content found in $skills_src"
  fi
}

# =============================================================================
# Validation functions
# =============================================================================

validate_skills() {
  section "Skills"

  local skill_files
  skill_files=$(find "$SCRIPT_DIR/skills" -path "*/SKILL.md" -type f 2>/dev/null | sort)

  if [ -z "$skill_files" ]; then
    warn "No SKILL.md files found"
    return
  fi

  local old_ifs="$IFS"
  IFS=$'\n'
  for skill_file in $skill_files; do
    IFS="$old_ifs"
    local skill_dir
    skill_dir=$(dirname "$skill_file")
    local skill_name
    skill_name=$(basename "$skill_dir")

    if has_frontmatter_field "$skill_file" "name"; then
      pass "$skill_name: has 'name' field"
    else
      fail "$skill_name: missing 'name' frontmatter field"
    fi

    if has_frontmatter_field "$skill_file" "description"; then
      pass "$skill_name: has 'description' field"

      local desc
      desc=$(get_frontmatter_field "$skill_file" "description")
      case "$desc" in
        "Use when"*)
          pass "$skill_name: description starts with 'Use when'"
          ;;
        *)
          fail "$skill_name: description should start with 'Use when', got: $(echo "$desc" | head -c 40)..."
          ;;
      esac
    else
      fail "$skill_name: missing 'description' frontmatter field"
    fi

    local other_md
    other_md=$(find "$skill_dir" -maxdepth 1 -name "*.md" -not -name "SKILL.md" -type f 2>/dev/null)
    if [ -n "$other_md" ]; then
      local old_ifs2="$IFS"
      IFS=$'\n'
      for md_file in $other_md; do
        IFS="$old_ifs2"
        if [ -f "$md_file" ]; then
          pass "$skill_name: prompt template $(basename "$md_file") exists"
        fi
      done
      IFS="$old_ifs2"
    fi
  done
  IFS="$old_ifs"
}

validate_rules() {
  section "Rules"

  local rule_files
  rule_files=$(find "$SCRIPT_DIR/rules" -name "*.md" -type f 2>/dev/null | sort)

  if [ -z "$rule_files" ]; then
    warn "No rule .md files found"
    return
  fi

  local old_ifs="$IFS"
  IFS=$'\n'
  for rule_file in $rule_files; do
    IFS="$old_ifs"
    local rule_name
    rule_name=$(basename "$rule_file")

    if has_frontmatter_field "$rule_file" "paths"; then
      pass "$rule_name: has 'paths' field"

      local paths_value
      paths_value=$(get_frontmatter_field "$rule_file" "paths")

      case "$paths_value" in
        "["*"]")
          fail "$rule_name: paths uses YAML array format, should use comma-separated quoted strings"
          ;;
        *)
          if echo "$paths_value" | grep -q '"'; then
            pass "$rule_name: paths uses comma-separated format"
          else
            fail "$rule_name: paths values should be quoted strings"
          fi
          ;;
      esac
    else
      fail "$rule_name: missing 'paths' frontmatter field"
    fi
  done
  IFS="$old_ifs"
}

validate_smoke() {
  section "Smoke Test"

  local tmpdir
  tmpdir=$(mktemp -d)
  # shellcheck disable=SC2064
  trap "rm -rf '$tmpdir'" EXIT

  printf "  Running installer into temp dir: %s\n" "$tmpdir"
  local install_output
  if install_output=$(HOME="$tmpdir" "$SCRIPT_DIR/at" install --target="$tmpdir" --non-interactive --all 2>&1); then
    pass "at install exited successfully"
  else
    fail "at install exited with non-zero status"
    printf "         %s\n" "$install_output"
    return
  fi

  local expected_rules="python.md typescript.md rust.md cpp.md design-principles.md tdd.md"
  for rule in $expected_rules; do
    if [ -f "$tmpdir/.claude/rules/$rule" ]; then
      pass "rule installed: $rule"
    else
      fail "rule missing: $tmpdir/.claude/rules/$rule"
    fi
  done

  local expected_skills="make-pr multi-review pr-babysit pr-make-till-merge review-and-fix"
  for skill in $expected_skills; do
    if [ -f "$tmpdir/.claude/skills/$skill/SKILL.md" ]; then
      pass "skill installed: $skill/SKILL.md"
    else
      fail "skill missing: $tmpdir/.claude/skills/$skill/SKILL.md"
    fi
  done

  # Idempotency: re-running the installer must succeed cleanly.
  if HOME="$tmpdir" "$SCRIPT_DIR/at" install --target="$tmpdir" --non-interactive --all >/dev/null 2>&1; then
    pass "at install is idempotent (second run succeeds)"
  else
    fail "at install failed on second run"
  fi

  rm -rf "$tmpdir"
  trap - EXIT
}

# =============================================================================
# Subcommand: install
# =============================================================================

cmd_install() {
  DRY_RUN="false"
  TARGET_DIR=""
  NON_INTERACTIVE="false"
  INSTALL_ALL="false"
  BACKUP_MANIFEST=""

  for arg in "$@"; do
    case "$arg" in
      --dry-run)
        DRY_RUN="true"
        ;;
      --target=*)
        TARGET_DIR="${arg#--target=}"
        ;;
      --non-interactive)
        NON_INTERACTIVE="true"
        ;;
      --all)
        INSTALL_ALL="true"
        ;;
      --help|-h)
        echo "Usage: at install [OPTIONS]"
        echo ""
        echo "Options:"
        echo "  --dry-run            Show what would be done without making changes"
        echo "  --target=<path>      Target project directory (default: current directory)"
        echo "  --non-interactive    Do not prompt for input"
        echo "  --all                Install all components"
        echo "  -h, --help           Show this help message"
        return 0
        ;;
      *)
        error "Unknown option: $arg"
        echo "Run 'at install --help' for usage."
        return 1
        ;;
    esac
  done

  if [ -z "$TARGET_DIR" ]; then
    TARGET_DIR="$(pwd)"
  fi

  if [ ! -d "$TARGET_DIR" ]; then
    error "Target directory does not exist: $TARGET_DIR"
    return 1
  fi

  TARGET_DIR="$( cd "$TARGET_DIR" && pwd )"
  BACKUP_MANIFEST="${TARGET_DIR}/.claude/.install-backup-manifest"

  echo ""
  printf "${BOLD}Claude Code Agent Templates Installer${RESET}\n"
  echo "======================================"
  echo ""
  echo "  Target: $TARGET_DIR"
  if [ "$DRY_RUN" = "true" ]; then
    echo "  Mode:   DRY RUN (no changes will be made)"
  fi
  echo ""

  # Track which components get installed for the manifest
  local did_rules="false"
  local did_skills="false"

  if [ "$INSTALL_ALL" = "true" ]; then
    install_rules
    install_skills
    did_rules="true"
    did_skills="true"

    echo ""
    echo "======================================"
    if [ "$DRY_RUN" = "true" ]; then
      dry "Dry run complete — no files were changed"
    else
      _write_manifest "$did_rules" "$did_skills"
      info "Installation complete!"
      echo ""
      echo "  Next steps:"
      echo "    1. Review .claude/rules/ for language-specific conventions"
      echo "    2. Add 'Bash(gh issue:*)' to permissions for GitHub issue integration"
    fi
    echo ""
    return 0
  fi

  if [ "$NON_INTERACTIVE" = "true" ]; then
    error "Non-interactive mode requires --all or specific component flags"
    echo "  Usage: at install --non-interactive --all"
    return 1
  fi

  # Interactive menu
  while true; do
    echo ""
    echo "  What would you like to install?"
    echo ""
    echo "    [1] Language Rules (python, typescript, rust, cpp)"
    echo "    [2] Skills (PR creation, review, repo upkeep)"
    echo "    [3] Everything"
    echo "    [0] Exit"
    echo ""
    printf "  Select options (comma-separated): "
    read -r choices

    choices="$(echo "$choices" | tr -d ' ')"

    if [ -z "$choices" ]; then
      continue
    fi

    OLD_IFS="$IFS"
    IFS=","
    set -- $choices
    IFS="$OLD_IFS"

    local_exit="false"
    for choice in "$@"; do
      case "$choice" in
        0)
          local_exit="true"
          ;;
        1)
          install_rules
          did_rules="true"
          ;;
        2)
          install_skills
          did_skills="true"
          ;;
        3)
          install_rules
          install_skills
          did_rules="true"
          did_skills="true"
          ;;
        *)
          warn "Unknown option: $choice"
          ;;
      esac
    done

    if [ "$local_exit" = "true" ]; then
      break
    fi

    echo ""
    echo "======================================"
    if [ "$DRY_RUN" = "true" ]; then
      dry "Dry run — no files were changed"
    else
      info "Done! Select more options or [0] to exit."
    fi
  done

  if [ "$DRY_RUN" != "true" ]; then
    _write_manifest "$did_rules" "$did_skills"
  fi

  echo ""
  info "Goodbye!"
}

_write_manifest() {
  local did_rules="$1"
  local did_skills="$2"

  local now
  now="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  local commit
  commit="$(git -C "$SCRIPT_DIR" rev-parse --short HEAD 2>/dev/null || echo "unknown")"

  # Read existing manifest for installed_at, or use now
  local installed_at
  installed_at="$(manifest_read_field "installed_at" 2>/dev/null || echo "")"
  if [ -z "$installed_at" ]; then
    installed_at="$now"
  fi

  manifest_write "$installed_at" "$now" "$SCRIPT_DIR" "$commit" \
    "$did_rules" "$did_skills" "$TARGET_DIR"
}

# =============================================================================
# Subcommand: update
# =============================================================================

cmd_update() {
  local skip_pull="false"
  local update_all="false"

  for arg in "$@"; do
    case "$arg" in
      --local)
        skip_pull="true"
        ;;
      --all)
        update_all="true"
        ;;
      --help|-h)
        echo "Usage: at update [OPTIONS]"
        echo ""
        echo "Options:"
        echo "  --local    Skip git pull, reinstall from local repo"
        echo "  --all      Reinstall all components (override manifest)"
        echo "  -h, --help Show this help message"
        return 0
        ;;
      *)
        error "Unknown option: $arg"
        return 1
        ;;
    esac
  done

  local mpath
  mpath="$(manifest_path)"
  if [ ! -f "$mpath" ]; then
    error "No installation manifest found. Run 'at install' first."
    return 1
  fi

  local repo_path
  repo_path="$(manifest_read_field "repo_path")"
  TARGET_DIR="$(manifest_read_field "target_dir")"
  BACKUP_MANIFEST="${TARGET_DIR}/.claude/.install-backup-manifest"
  DRY_RUN="false"
  NON_INTERACTIVE="true"

  if [ -z "$repo_path" ] || [ -z "$TARGET_DIR" ]; then
    error "Manifest is missing required fields (repo_path, target_dir)"
    return 1
  fi

  echo ""
  printf "${BOLD}Claude Code Agent Templates — Update${RESET}\n"
  echo "======================================"
  echo ""
  echo "  Repository: $repo_path"
  echo "  Target:     $TARGET_DIR"
  echo ""

  if [ "$skip_pull" = "false" ]; then
    info "Pulling latest changes..."
    if git -C "$repo_path" pull --ff-only 2>&1; then
      info "Repository updated"
    else
      error "git pull --ff-only failed. Use --local to skip, or resolve manually."
      return 1
    fi
  else
    info "Skipping git pull (--local)"
  fi

  local comp_rules comp_skills
  if [ "$update_all" = "true" ]; then
    comp_rules="true"
    comp_skills="true"
  else
    comp_rules="$(manifest_read_field "components.rules" 2>/dev/null || echo "false")"
    comp_skills="$(manifest_read_field "components.skills" 2>/dev/null || echo "false")"
  fi

  echo ""
  info "Reinstalling components..."

  if [ "$comp_rules" = "true" ]; then
    install_rules
  fi

  if [ "$comp_skills" = "true" ]; then
    install_skills
  fi

  # Update manifest with new commit and timestamp
  local now
  now="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  local installed_at
  installed_at="$(manifest_read_field "installed_at" 2>/dev/null || echo "$now")"
  local commit
  commit="$(git -C "$repo_path" rev-parse --short HEAD 2>/dev/null || echo "unknown")"

  manifest_write "$installed_at" "$now" "$repo_path" "$commit" \
    "$comp_rules" "$comp_skills" "$TARGET_DIR"

  echo ""
  info "Update complete!"
}

# =============================================================================
# Subcommand: uninstall
# =============================================================================

cmd_uninstall() {
  DRY_RUN="false"
  TARGET_DIR=""

  for arg in "$@"; do
    case "$arg" in
      --dry-run)
        DRY_RUN="true"
        ;;
      --target=*)
        TARGET_DIR="${arg#--target=}"
        ;;
      --help|-h)
        echo "Usage: at uninstall [OPTIONS]"
        echo ""
        echo "Options:"
        echo "  --dry-run        Show what would be done without making changes"
        echo "  --target=<path>  Target project directory (reads from manifest if omitted)"
        echo "  -h, --help       Show this help message"
        return 0
        ;;
      *)
        error "Unknown option: $arg"
        return 1
        ;;
    esac
  done

  # Resolve target from manifest if not provided
  if [ -z "$TARGET_DIR" ]; then
    TARGET_DIR="$(manifest_read_field "target_dir" 2>/dev/null || echo "")"
  fi

  if [ -z "$TARGET_DIR" ]; then
    error "No target directory. Provide --target= or run 'at install' first."
    return 1
  fi

  TARGET_DIR="$( cd "$TARGET_DIR" && pwd )"
  BACKUP_MANIFEST="${TARGET_DIR}/.claude/.install-backup-manifest"

  echo ""
  printf "${BOLD}Claude Code Agent Templates — Uninstall${RESET}\n"
  echo "========================================"
  echo ""
  echo "  Target:   $TARGET_DIR"
  echo "  Manifest: $BACKUP_MANIFEST"
  echo ""

  if [ "$DRY_RUN" = "true" ]; then
    dry "Preview of rollback:"
    echo ""
  fi

  rollback || true

  if [ "$DRY_RUN" != "true" ]; then
    manifest_clear
  fi

  echo ""
  info "Uninstall complete"
}

# =============================================================================
# Subcommand: validate
# =============================================================================

validate_v1() {
  section "Schemas"

  if [ ! -d "$SCRIPT_DIR/schemas" ]; then
    warn "No schemas directory found"
    return
  fi
  if ! command -v python3 >/dev/null 2>&1; then
    warn "python3 not found — skipping schema checks"
    return
  fi

  local output
  if output=$(python3 "$SCRIPT_DIR/scripts/check_prompt_schemas.py" 2>&1); then
    pass "agent prompts match their return schemas"
  else
    fail "agent prompt(s) drifted from their return schemas"
    printf '%s\n' "$output" | sed 's/^/    /'
  fi
}

cmd_validate() {
  local v_skills=false
  local v_rules=false
  local v_smoke=false
  local v_v1=false

  for arg in "$@"; do
    case "$arg" in
      --skills)   v_skills=true ;;
      --rules)    v_rules=true ;;
      --smoke)    v_smoke=true ;;
      --v1)       v_v1=true ;;
      --help|-h)
        echo "Usage: at validate [OPTIONS]"
        echo ""
        echo "With no flags, validates everything except smoke tests."
        echo ""
        echo "Options:"
        echo "  --skills     Validate skill definitions"
        echo "  --rules      Validate rule files"
        echo "  --v1         Validate agent return schemas + prompt shapes"
        echo "  --smoke      Run smoke tests (installs into temp dir)"
        echo "  -h, --help   Show this help message"
        return 0
        ;;
      *)
        error "Unknown option: $arg"
        return 1
        ;;
    esac
  done

  # Default: everything except smoke
  if [ "$v_skills" = false ] && [ "$v_rules" = false ] && \
     [ "$v_smoke" = false ] && [ "$v_v1" = false ]; then
    v_skills=true
    v_rules=true
    v_v1=true
  fi

  PASS_COUNT=0
  FAIL_COUNT=0

  printf "${BOLD}agent-templates validation${RESET}\n"

  if [ "$v_skills" = true ]; then
    validate_skills
  fi

  if [ "$v_rules" = true ]; then
    validate_rules
  fi

  if [ "$v_v1" = true ]; then
    validate_v1
  fi

  if [ "$v_smoke" = true ]; then
    validate_smoke
  fi

  printf "\n${BOLD}--- Summary ---${RESET}\n"
  printf "  ${GREEN}%d passed${RESET}, ${RED}%d failed${RESET}\n" "$PASS_COUNT" "$FAIL_COUNT"

  if [ "$FAIL_COUNT" -gt 0 ]; then
    return 1
  fi
}

# =============================================================================
# Subcommand: status
# =============================================================================

cmd_status() {
  for arg in "$@"; do
    case "$arg" in
      --help|-h)
        echo "Usage: at status"
        echo ""
        echo "Show installation status dashboard."
        return 0
        ;;
      *)
        error "Unknown option: $arg"
        return 1
        ;;
    esac
  done

  echo ""
  printf "${BOLD}Agent Templates Status${RESET}\n"
  echo "======================"
  echo ""

  # --- Installed Components ---
  section "Installed Components"

  local rules_count=0
  if [ -d "$HOME/.claude/rules" ]; then
    for f in "$HOME/.claude/rules"/*.md; do
      [ -f "$f" ] && rules_count=$((rules_count + 1))
    done
  fi
  printf "  Rules:  %d files in ~/.claude/rules/\n" "$rules_count"

  local skills_count=0
  if [ -d "$HOME/.claude/skills" ]; then
    for d in "$HOME/.claude/skills"/*/; do
      [ -d "$d" ] && skills_count=$((skills_count + 1))
    done
  fi
  printf "  Skills: %d dirs in ~/.claude/skills/\n" "$skills_count"

  # --- Repository ---
  section "Repository"

  local repo_path
  repo_path="$(manifest_read_field "repo_path" 2>/dev/null || echo "")"
  if [ -z "$repo_path" ]; then
    repo_path="$SCRIPT_DIR"
  fi

  printf "  Path:   %s\n" "$repo_path"

  if [ -d "$repo_path/.git" ]; then
    local current_commit
    current_commit="$(git -C "$repo_path" rev-parse --short HEAD 2>/dev/null || echo "unknown")"
    printf "  Commit: %s\n" "$current_commit"

    local current_branch
    current_branch="$(git -C "$repo_path" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown")"
    printf "  Branch: %s\n" "$current_branch"

    # Ahead/behind origin (if remote exists)
    if git -C "$repo_path" remote get-url origin >/dev/null 2>&1; then
      local ahead_behind
      ahead_behind="$(git -C "$repo_path" rev-list --left-right --count "${current_branch}...origin/${current_branch}" 2>/dev/null || echo "")"
      if [ -n "$ahead_behind" ]; then
        local ahead behind
        ahead="$(echo "$ahead_behind" | cut -f1)"
        behind="$(echo "$ahead_behind" | cut -f2)"
        printf "  Status: %s ahead, %s behind origin/%s\n" "$ahead" "$behind" "$current_branch"
      fi
    fi
  else
    printf "  (not a git repository)\n"
  fi

  # --- Last Updated ---
  section "Last Updated"

  local installed_at
  installed_at="$(manifest_read_field "installed_at" 2>/dev/null || echo "")"
  local updated_at
  updated_at="$(manifest_read_field "updated_at" 2>/dev/null || echo "")"

  if [ -n "$installed_at" ]; then
    printf "  Installed: %s\n" "$installed_at"
  else
    printf "  Installed: (no manifest found)\n"
  fi

  if [ -n "$updated_at" ]; then
    printf "  Updated:   %s\n" "$updated_at"
  else
    printf "  Updated:   (no manifest found)\n"
  fi

  # --- Config Health ---
  section "Config Health"

  if command -v gh >/dev/null 2>&1; then
    if gh auth status >/dev/null 2>&1; then
      printf "  gh auth: ${GREEN}authenticated${RESET}\n"
    else
      printf "  gh auth: ${RED}not authenticated${RESET}\n"
    fi
  else
    printf "  gh auth: ${YELLOW}gh CLI not installed${RESET}\n"
  fi

  echo ""
}

# =============================================================================
# Usage
# =============================================================================

usage() {
  cat <<EOF
at — Unified CLI for Claude Code Agent Templates (v${AT_VERSION})

Usage:
  at <command> [options]

Commands:
  install     Install rules and skills
  update      Pull latest and reinstall tracked components
  uninstall   Restore backups and remove installed files
  validate    Validate all agent-templates artifacts
  status      Show installation status dashboard

Options:
  -h, --help      Show this help message
  --version       Show version

Install options:
  --all                Install all components
  --target=<path>      Target project directory (default: cwd)
  --dry-run            Preview changes without writing
  --non-interactive    No prompts

Update options:
  --local    Skip git pull, reinstall from local repo
  --all      Reinstall all components (override manifest)

Uninstall options:
  --dry-run    Preview changes without writing
  --target=<path>  Target project directory

Validate options:
  --skills     Validate skill definitions
  --rules      Validate rule files
  --v1         Validate agent return schemas + prompt shapes
  --smoke      Run smoke tests

Examples:
  at install --all                     Install everything
  at install --dry-run --all           Preview full install
  at update --local                    Reinstall without pulling
  at uninstall --dry-run               Preview uninstall
  at validate --smoke                  Run smoke tests
  at status                            Show dashboard
EOF
}

# =============================================================================
# Main dispatch
# =============================================================================

if [ $# -eq 0 ]; then
  usage
  exit 0
fi

command="$1"
shift

case "$command" in
  install)
    cmd_install "$@"
    ;;
  update)
    cmd_update "$@"
    ;;
  uninstall)
    cmd_uninstall "$@"
    ;;
  validate)
    cmd_validate "$@"
    ;;
  status)
    cmd_status "$@"
    ;;
  --help|-h)
    usage
    ;;
  --version)
    echo "at version ${AT_VERSION}"
    ;;
  *)
    error "Unknown command: $command"
    echo "Run 'at --help' for usage."
    exit 1
    ;;
esac
