{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence.schema.json",
  "title": "Run evidence handoff",
  "$comment": "Written by make-pr / make-pr-lite at Done to <run_root>/evidence/<branch-slug>/evidence.json; read by pr-explain to build the proof chapter. A distillation of runs the pipeline already witnessed, never new claims.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "branch", "pipeline", "behaviors", "gates", "runtime"],
  "properties": {
    "schema_version": { "$ref": "_defs.schema.json#/$defs/schema_version" },
    "branch": { "type": "string", "minLength": 1 },
    "pipeline": { "enum": ["make-pr", "make-pr-lite"] },
    "behaviors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind", "test", "files", "red", "green"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["behavioral", "non_behavioral"] },
          "test": { "type": ["string", "null"] },
          "files": { "type": "array", "items": { "type": "string" } },
          "red": { "oneOf": [{ "$ref": "#/$defs/witness" }, { "type": "null" }] },
          "green": { "oneOf": [{ "$ref": "#/$defs/green_witness" }, { "type": "null" }] }
        },
        "allOf": [
          {
            "$comment": "A behavioral slice carries its full RED->GREEN witness pair; the proof chapter must never have to invent one.",
            "if": { "required": ["kind"], "properties": { "kind": { "const": "behavioral" } } },
            "then": {
              "properties": {
                "test": { "type": "string", "minLength": 1 },
                "red": { "$ref": "#/$defs/witness" },
                "green": { "$ref": "#/$defs/green_witness" }
              }
            }
          },
          {
            "$comment": "A non-behavioral row carries no witnesses; kind is behavioral iff the witness pair is present.",
            "if": { "required": ["kind"], "properties": { "kind": { "const": "non_behavioral" } } },
            "then": {
              "properties": {
                "test": { "type": "null" },
                "red": { "type": "null" },
                "green": { "type": "null" }
              }
            }
          }
        ]
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "cmd", "exit_code", "key_output"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "cmd": { "type": "string", "minLength": 1 },
          "exit_code": { "type": "integer" },
          "key_output": { "type": "string", "minLength": 1 }
        }
      }
    },
    "runtime": {
      "$comment": "Evidence that the built artifact itself was watched working — pr-explain scores these rows into its proof chapter, where tests and gates together are worth 7 of 100 and can never clear the bar alone.",
      "type": "array",
      "items": { "$ref": "#/$defs/runtime_evidence" }
    }
  },
  "$defs": {
    "runtime_evidence": {
      "$comment": "One captured run of the built artifact, classified by what makes it strong. Either a file copied into runtime/ (a screenshot) or the verbatim output, or both.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "what", "cmd"],
      "anyOf": [{ "required": ["path"] }, { "required": ["key_output"] }],
      "properties": {
        "kind": {
          "$comment": "before_after: one command on the base and on the head. screenshot: a picture of the surface running. replay: one deterministic command a reader reruns to reproduce it. run_output: the built artifact driven end to end. load_bearing: the change reverted, and the break it caused. measurement: a number for a claim the PR makes.",
          "enum": [
            "before_after",
            "screenshot",
            "replay",
            "run_output",
            "load_bearing",
            "measurement"
          ]
        },
        "what": { "type": "string", "minLength": 1 },
        "cmd": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "key_output": { "type": "string", "minLength": 1 }
      }
    },
    "witness": {
      "$comment": "One witnessed command run, quoted verbatim from the run that produced it.",
      "type": "object",
      "additionalProperties": false,
      "required": ["cmd", "exit_code", "key_output"],
      "properties": {
        "cmd": { "type": "string", "minLength": 1 },
        "exit_code": { "type": "integer" },
        "key_output": { "type": "string", "minLength": 1 }
      }
    },
    "green_witness": {
      "$comment": "The passing run plus the line count that made it pass; lines_added is null only when not derivable.",
      "type": "object",
      "additionalProperties": false,
      "required": ["cmd", "exit_code", "key_output", "lines_added"],
      "properties": {
        "cmd": { "type": "string", "minLength": 1 },
        "exit_code": { "type": "integer" },
        "key_output": { "type": "string", "minLength": 1 },
        "lines_added": { "type": ["integer", "null"], "minimum": 0 }
      }
    }
  }
}
